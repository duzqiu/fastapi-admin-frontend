# 前端 Docker 部署的环境变量模板（配套 docker-compose.yml 使用）
#
#   cp .env.docker.example .env      # 文件名必须是 .env，compose 才会自动读取
#   然后按实际情况修改
#
# 原理：docker-compose.yml 里用的是 ${变量:-默认值} 插值，这个文件里的值会覆盖默认值。

# ===================== 访问端口 =====================
# 宿主机映射端口。80 端口通常被系统 / NAS 面板占用，默认给 8080
FRONTEND_PORT=8080

# ===================== 后端接口地址 =====================
# 【默认 · 零配置】走宿主机映射端口访问后端（后端已把 8000 发布到宿主机）。
# 这个模式下前端容器不接入任何额外网络（compose 里不声明 networks），
# Compose 会自动建一个「用户自定义网络」，因此既不会出现
# 「external 网络找不到」，也不会出现「默认 bridge 不支持别名」的报错。
# 浏览器始终只访问前端这一个源，所以后端 BACKEND_CORS_ORIGINS 依然不用改。
API_UPSTREAM=http://host.docker.internal:8000

# 【可选 · 共享网络】少一层 NAT，用服务名 / 容器名直连后端。需要三处一起改：
#   ① 本文件：上面的 API_UPSTREAM 改成 http://backend:8000
#   ② 本文件：下面 BACKEND_NETWORK 改成后端的真实网络名
#   ③ docker-compose.yml：打开两处标注「接法 B」的 networks 注释块
# 网络名查法（admin-backend 是后端容器名）：
#   docker inspect admin-backend --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'
# 注意默认是「后端 compose 项目名_default」，项目名取自目录名，
# 例如后端放在 fastapi-admin-backend 目录下就是 fastapi-admin-backend_default。
# 下面这项只在接法 B 生效，接法 A 完全不读它。
BACKEND_NETWORK=fastapi-admin_default

# ===================== 构建期网络 / 镜像源（可选）=====================
# 基础镜像拉不动时（403 / 401 / manifest unknown），多半是 Docker daemon 里配的加速器失效了。
# 填「完整仓库地址」可绕过加速器，先在宿主机 docker pull 验证可达：
#   NODE_IMAGE=docker.m.daocloud.io/library/node:26-alpine
#   NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.30-alpine
# Node 26 目前仍是 Current（预计 2026-10 转入 LTS）；alpine 版体积小、构建更快，
# 且只用于构建阶段，产物会拷进 nginx 阶段。想用 LTS 就写成 node:24。
# Node 20 已于 2026-04 EOL。
NODE_IMAGE=node:26-alpine
# nginx 1.30 是 stable 分支（1.31 为 mainline）；要完全固定可写 1.30.5-alpine
NGINX_IMAGE=nginx:1.30-alpine

# npm 源：国内用 npmmirror 明显更快；能直连 npmjs 时改回 https://registry.npmjs.org
NPM_REGISTRY=https://registry.npmmirror.com

# ===================== 构建期注入前端的接口配置 =====================
# 必须是相对路径 /api/v1，配合 Nginx 反代实现同源，天然没有跨域问题
VITE_API_BASE_URL=/api/v1
VITE_API_TIMEOUT=20000

# 若坚持「前后端不同域」（浏览器直接访问后端 8000），改成完整地址，
# 并把前端访问地址加进后端 .env 的 BACKEND_CORS_ORIGINS，否则会被 CORS 拦下：
# VITE_API_BASE_URL=http://192.168.1.10:8000/api/v1

# ===================== 其它 =====================
TZ=Asia/Shanghai
